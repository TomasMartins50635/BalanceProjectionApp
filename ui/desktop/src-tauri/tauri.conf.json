{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestão Tesouraria",
  "version": "0.1.0",
  "identifier": "com.balanceprojection.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "cd ../web && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gestão Tesouraria",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_FROM_tauri_signer_generate",
      "endpoints": ["http://YOUR_SERVER_IP:5535/updates/latest"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortcutName": "Gestão Tesouraria",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
