FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/BalanceProjectionApp.SyncServer/BalanceProjectionApp.SyncServer.csproj src/BalanceProjectionApp.SyncServer/
RUN dotnet restore src/BalanceProjectionApp.SyncServer/BalanceProjectionApp.SyncServer.csproj

COPY src/BalanceProjectionApp.SyncServer/ src/BalanceProjectionApp.SyncServer/

RUN dotnet publish src/BalanceProjectionApp.SyncServer/BalanceProjectionApp.SyncServer.csproj \
    -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8081
EXPOSE 8081

ENTRYPOINT ["dotnet", "BalanceProjectionApp.SyncServer.dll"]
